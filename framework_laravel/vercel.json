{
  "version": 2,
  "functions": {
    "api/index.php": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/health.php": {
      "memory": 512
    }
  },
  "routes": [
    {
      "src": "/health",
      "dest": "/api/health.php"
    },
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)$",
      "dest": "/api/index.php"
    }
  ]
}
