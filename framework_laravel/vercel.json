{
  "version": 2,
  "public": "public",
  "functions": {
    "api/index.php": {
      "runtime": "php:8.2"
    }
  },
  "routes": [
    {
      "src": "/(.+)$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/(?:.+/)?.+\\..+$",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
